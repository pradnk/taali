{
  "name": "audio-certificate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets:generate": "node scripts/generate-audio-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "sample": "node --experimental-strip-types --import ./scripts/register-hook.mjs scripts/render-sample-certificate.mts",
    "sample:real": "node --experimental-strip-types --import ./scripts/register-hook.mjs scripts/render-real-certificate.mts",
    "seed:partners": "node --experimental-strip-types --import ./scripts/register-hook.mjs scripts/seed-partner-logos.mts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.6.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "node-web-audio-api": "^2.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
