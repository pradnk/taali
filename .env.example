# Copy to .env.local and fill in. Never commit .env.local.
# See the "The other settings" section of README.md for details.

# Neon connection string -- use the POOLED one.
DATABASE_URL=

# Team passcode for signing in. At least 12 characters: use a passphrase.
ADMIN_PASSCODE=

# Signs the sign-in cookie. Changing it signs everyone out.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ElevenLabs API key (Profile -> API Keys). Library voices need the Starter plan.
ELEVENLABS_API_KEY=

# Vercel Blob storage for the finished sound files. Set automatically in Vercel
# once a Blob store is connected to the project; needed here only when running
# audio generation locally.
BLOB_READ_WRITE_TOKEN=

# The address every QR code encodes. Baked in at build time.
# Locally, http://localhost:3000 -- QR codes cannot work from a phone in that
# case, so never print real certificates from a local run.
# In production this must be the project's PERMANENT address (a custom domain,
# or project-team.vercel.app -- not project-a1b2c3d4e-team.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
